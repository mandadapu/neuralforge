# -----------------------------------------------------------------------
# CORS — required for API servers (sast_013)
#
# Comma-separated list of trusted origins that may make cross-origin
# requests to the API.  There is NO default; every deployment must set
# this explicitly.  A wildcard ("*") is intentionally not supported.
#
# Example (single origin):
#   ALLOWED_ORIGINS=https://app.example.com
#
# Example (multiple origins):
#   ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# -----------------------------------------------------------------------
ALLOWED_ORIGINS=
